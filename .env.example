# Copy to .env and fill in real values. Never commit .env.

# --- App ---
APP_ENV=development
APP_NAME=affiliate-ai
TIMEZONE=Asia/Jakarta

# --- Backend ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
SECRET_KEY=change-me-to-a-long-random-string
CORS_ORIGINS=http://localhost:3000

# --- Database ---
POSTGRES_USER=affiliate
POSTGRES_PASSWORD=change-me
POSTGRES_DB=affiliate
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://affiliate:change-me@postgres:5432/affiliate

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- AI providers ---
# AI_PROVIDER: openai | openai_compatible | deepseek | groq | openrouter |
#              together | ollama | lmstudio | custom | mock
# Use "mock" to exercise the full pipeline locally without a real API call.
AI_PROVIDER=openai
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=https://api.openai.com/v1
AI_TIMEOUT_SECONDS=60
AI_MAX_RETRIES=3
AI_TEXT_MODEL=
AI_IMAGE_MODEL=

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
# Comma-separated allow-list. At least one is required, otherwise the bot
# rejects every user (secure by default).
TELEGRAM_ADMIN_USER_ID=
TELEGRAM_ADMIN_CHAT_ID=
TELEGRAM_POLL_TIMEOUT=30
TELEGRAM_STATE_TTL_SECONDS=3600
TELEGRAM_HEARTBEAT_FILE=/tmp/telegram_bot_heartbeat
FRONTEND_BASE_URL=http://localhost:3000

# --- Media ---
MEDIA_URL_PREFIX=/media
MEDIA_MAX_FILE_SIZE_MB=20
MEDIA_ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp,image/gif
MEDIA_ALLOWED_VIDEO_TYPES=video/mp4,video/quicktime,video/webm

# --- Frontend ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# Address the frontend container uses to reach the API for server-side
# rendering (inside compose that is the service name, not localhost).
# Defaults to NEXT_PUBLIC_API_BASE_URL when unset.
API_INTERNAL_BASE_URL=http://backend:8000
